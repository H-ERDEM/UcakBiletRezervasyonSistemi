<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.GaussianBlur?>



<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="BiletEkraniController"
            prefWidth="1000" prefHeight="650"
            styleClass="root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <ImageView fitWidth="49" fitHeight="49" preserveRatio="true">
                <image>
                    <Image url="/travel1.png"/>
                </image>
            </ImageView>
            <Label text="Uçak Bilet Rezervasyon Sistemi" styleClass="app-title"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="Çıkış" onAction="#handleCikis" styleClass="btn-cikis"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="rootStack" BorderPane.alignment="CENTER">

            <VBox fx:id="loginPane" alignment="CENTER" spacing="20" styleClass="login-container"
                  maxWidth="400" maxHeight="300">
                <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>
                <Label text="Giriş Yap" styleClass="login-title"/>
                <TextField fx:id="txtLoginKullanici" promptText="Kullanıcı adı" styleClass="login-input"/>
                <PasswordField fx:id="txtLoginSifre" promptText="Şifre" styleClass="login-input"/>
                <Button text="Giriş" onAction="#handleLogin" styleClass="btn-login" maxWidth="Infinity"/>
                <Label fx:id="lblLoginHata" styleClass="error-text"/>
            </VBox>

            <VBox fx:id="menuPane" visible="false" managed="false" alignment="CENTER" spacing="15" styleClass="menu-container"
                  maxWidth="400" maxHeight="400">
                <padding><Insets top="30" right="50" bottom="30" left="50"/></padding>
                <Label text="Ana Menü" styleClass="menu-title"/>
                <Button text="Bilet Ekle" onAction="#goEkle" maxWidth="Infinity" styleClass="btn-menu"/>
                <Button text="Biletleri Listele / Sil / Güncelle / Sırala" onAction="#goListe" maxWidth="Infinity" styleClass="btn-menu"/>
                <Button text="Bilet Sorgula" onAction="#goSorgula" maxWidth="Infinity" styleClass="btn-menu"/>
                <Button text="İşlem Geçmişi" onAction="#goGecmis" maxWidth="Infinity" styleClass="btn-menu"/>
            </VBox>

            <StackPane fx:id="eklePane" visible="false" managed="false"
                       maxWidth="600" maxHeight="600" styleClass="ekle-container">

                <VBox spacing="15" styleClass="ekle-content-box">
                    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                    <Label text="Bilet Ekle / Güncelle" styleClass="ekle-title"/>
                    <GridPane hgap="15" vgap="15" styleClass="ekle-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30"/>
                            <ColumnConstraints percentWidth="70"/>
                        </columnConstraints>
                        <Label text="Ad:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="ekle-label"/>
                        <TextField fx:id="txtAdEkle" promptText="Yolcu Adı" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="ekle-input"/>
                        <Label text="Soyad:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="ekle-label"/>
                        <TextField fx:id="txtSoyadEkle" promptText="Yolcu Soyadı" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="ekle-input"/>
                        <Label text="TC No:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="ekle-label"/>
                        <TextField fx:id="txtTcEkle" promptText="TC Kimlik Numarası" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="ekle-input"/>
                        <Label text="Uçuş No:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="ekle-label"/>
                        <TextField fx:id="txtUcusNoEkle" promptText="Uçuş Numarası" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="ekle-input"/>
                        <Label text="Koltuk No:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="ekle-label"/>
                        <TextField fx:id="txtKoltukEkle" promptText="Örn: 1A (En fazla 2 Rakam ve A-D Harfleri arası)" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="ekle-input"/>
                        <Label text="Tarih:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="ekle-label"/>
                        <TextField fx:id="txtTarihEkle" promptText="dd.MM.yyyy" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="ekle-input"/>
                        <Label text="Saat:" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="ekle-label"/>
                        <TextField fx:id="txtSaatEkle" promptText="HH.mm" GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="ekle-input"/>
                        <Label text="Fiyat:" GridPane.rowIndex="7" GridPane.columnIndex="0" styleClass="ekle-label"/>
                        <TextField fx:id="txtFiyatEkle" promptText="Örn: 3000" GridPane.rowIndex="7" GridPane.columnIndex="1" styleClass="ekle-input"/>
                    </GridPane>

                    <Label fx:id="lblMesaj" text="" styleClass="ekle-message-text" wrapText="true"/>
                    <HBox spacing="10">
                        <Button text="Kaydet" onAction="#handleBiletEkle" styleClass="btn-ekle-kaydet"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="Ana Menü" onAction="#goMenu" styleClass="btn-ekle-menu"/>

                    </HBox>
                </VBox>
            </StackPane>

            <VBox fx:id="listePane" visible="false" managed="false" spacing="15" styleClass="liste-container"
                  maxWidth="800" maxHeight="600">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Label text="Bilet Listesi" styleClass="liste-title"/>

                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="liste-sirala-box">
                    <Label text="Sıralama Kriteri:" styleClass="liste-label"/>
                    <ChoiceBox fx:id="cbSiralaKriter" prefWidth="150" styleClass="liste-choice-box"/>
                    <Button text="Sırala" onAction="#handleSirala" styleClass="btn-liste-sirala"/>
                </HBox>

                <TableView fx:id="tblBiletler" VBox.vgrow="ALWAYS" styleClass="liste-tablo">
                    <columns>
                        <TableColumn fx:id="colAd" text="Ad" prefWidth="100"/>
                        <TableColumn fx:id="colSoyad" text="Soyad" prefWidth="100"/>
                        <TableColumn fx:id="colTc" text="TC" prefWidth="120"/>
                        <TableColumn fx:id="colUcusNo" text="Uçuş No" prefWidth="80"/>
                        <TableColumn fx:id="colKoltuk" text="Koltuk" prefWidth="80"/>
                        <TableColumn fx:id="colTarih" text="Tarih" prefWidth="100"/>
                        <TableColumn fx:id="colSaat" text="Saat" prefWidth="80"/>
                        <TableColumn fx:id="colFiyat" text="Fiyat" prefWidth="80"/>
                    </columns>
                </TableView>

                <HBox spacing="10" styleClass="liste-buton-box">
                    <Button text="Seçili Bileti Sil" onAction="#handleListeSil" styleClass="btn-liste-sil"/>
                    <Button text="Seçili Bileti Güncelle" onAction="#handleListeGuncelle" styleClass="btn-liste-guncelle"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="Ana Menü" onAction="#goMenu" styleClass="btn-liste-menu"/>
                </HBox>
            </VBox>

            <VBox fx:id="sorgulaPane" visible="false" managed="false" spacing="15" styleClass="sorgula-container"
                  maxWidth="600" maxHeight="600">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>
                <Label text="Bilet Sorgula" styleClass="sorgula-title"/>

                <fx:define>
                    <ToggleGroup fx:id="sorguGrup"/>
                </fx:define>

                <HBox spacing="10" styleClass="sorgula-radio-box">
                    <RadioButton fx:id="rbSorguTc" text="TC ile" toggleGroup="$sorguGrup" selected="true" styleClass="sorgula-radio"/>
                    <RadioButton fx:id="rbSorguUcusNo" text="Uçuş No ile" toggleGroup="$sorguGrup" styleClass="sorgula-radio"/>
                </HBox>

                <TextField fx:id="txtSorguDeger" promptText="Aranacak değeri girin" styleClass="sorgula-input"/>
                <Button text="Sorgula" onAction="#handleSorgula" styleClass="btn-sorgula" maxWidth="Infinity"/>

                <Label text="Sonuç:" styleClass="sorgula-label"/>
                <TextArea fx:id="taSorguSonuc" editable="false" prefRowCount="6" VBox.vgrow="ALWAYS" styleClass="sorgula-output"/>

                <HBox spacing="10">
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="Ana Menü" onAction="#goMenu" styleClass="btn-sorgula-menu"/>
                </HBox>
            </VBox>

            <VBox fx:id="gecmisPane" visible="false" managed="false" spacing="15" styleClass="gecmis-container"
                  maxWidth="600" maxHeight="800">
                <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
                <Label text="İşlem Geçmişi" styleClass="gecmis-title"/>
                <TextArea fx:id="taGecmis" editable="false" prefRowCount="12" VBox.vgrow="ALWAYS" styleClass="gecmis-output"/>
                <HBox spacing="10">
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="Ana Menü" onAction="#goMenu" styleClass="btn-gecmis-menu"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>